+// Stops the game while its window is in the background, the way the game pauses itself while it
+// loads: bit 0x2 of the main loop's flags stops the game's own work, and setting the counter at
+// -0x7F80(r13) to 5 lets the main loop clear the bit again five frames later. A pause the game made
+// itself is left to the game. Called once a frame from the sound thread's loop below.
+//
+// Pausa el juego mientras su ventana está en segundo plano (F10, Controller settings).
+void PauseWhileInBackground() {
+    constexpr uint32_t kPauseCounter = 0x803A6740u; // -0x7F80(r13)
+    static bool s_pausedHere = false;
+    const bool background = SDL_GetKeyboardFocus() == nullptr;
+    const bool wanted = background && ForeignGameOptions::g_pauseWhenUnfocused.load(std::memory_order_relaxed);
+    const uint32_t flags = Memory::Read32(kMainLoopFlags);
+    if (wanted && !s_pausedHere) {
+        if ((flags & 2u) != 0) {
+            return; // the game is already paused by itself; it will resume by itself
+        }
+        Memory::Write32(kPauseCounter, 0xFFFFFFFFu);
+        Memory::Write32(kMainLoopFlags, (flags & ~1u) | 2u);
+        s_pausedHere = true;
+        RT_LOG(RT_TAG_MOD) << "Window in the background: game paused" << std::endl;
+    } else if (wanted && s_pausedHere) {
+        // Keep it paused even if something counted the pause down meanwhile.
+        Memory::Write32(kPauseCounter, 0xFFFFFFFFu);
+        Memory::Write32(kMainLoopFlags, (flags & ~1u) | 2u);
+    } else if (!wanted && s_pausedHere) {
+        Memory::Write32(kPauseCounter, 5);
+        s_pausedHere = false;
+        RT_LOG(RT_TAG_MOD) << "Window back in front: game resumed" << std::endl;
+    }
+}
+
 } // namespace
 } // namespace TraumaCenterWaits
 
