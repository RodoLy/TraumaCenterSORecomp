diff --git a/runtime/include/foreign_game_options.h b/runtime/include/foreign_game_options.h
new file mode 100644
--- /dev/null
+++ b/runtime/include/foreign_game_options.h
@@ -0,0 +1,16 @@
+#pragma once
+
+// Choices for a game played with the emulated Wii Remote that the game's own code reads while it
+// runs (F10, Controller settings). Each starts from Config.toml and changes at once when the player
+// picks another; the settings overlay also saves it.
+
+#include "runtime_config.h"
+
+#include <atomic>
+
+namespace ForeignGameOptions {
+
+// Stop the game while its window is in the background (Config.toml [controls] pause_when_unfocused).
+inline std::atomic_bool g_pauseWhenUnfocused{RuntimeConfigFile::PauseWhenUnfocused(false)};
+
+} // namespace ForeignGameOptions
