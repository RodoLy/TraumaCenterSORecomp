+void log_draw_extents(int frames) noexcept {
+  s_extentFramesLeft.store(frames, std::memory_order_relaxed);
+  s_extentLinesThisFrame = 0;
+  if (frames > 0) {
+    Log.info("draw-extent: logging the next {} frames", frames);
+  }
+}
+
+void draw_extents_frame_shown() noexcept {
+  if (s_extentFramesLeft.load(std::memory_order_relaxed) > 0) {
+    s_extentFramesLeft.fetch_sub(1, std::memory_order_relaxed);
+    s_extentLinesThisFrame = 0;
+    Log.info("draw-extent: frame shown");
+  }
+}
