+// Trauma Center: Second Opinion with the mouse alone. The game picks a surgical tool with the
+// Nunchuk's stick: eight tools sit in a ring of hexagons around a center at the bottom left of the
+// screen, and pushing the stick toward one picks it. Here a left click on one of those hexagons
+// pushes the stick toward it instead of pressing A, for as long as the button is held (and at least
+// a few frames, so a quick click still counts). Everywhere else the left click is A, as always.
+//
+// The ring was measured on the 640x480 picture: center at (100, 387), tools about 50 units away.
+// A click closer than 20 units to the center, or farther than 80, is not on the ring.
+//
+// Elegir herramientas con el mouse: un clic sobre un hexágono del menú de herramientas empuja el
+// stick del Nunchuk hacia esa herramienta, en lugar de apretar A.
+namespace TraumaCenterMouse {
+
+constexpr float kGameWidth = 640.0f;
+constexpr float kGameHeight = 480.0f;
+constexpr float kRingCenterX = 100.0f;
+constexpr float kRingCenterY = 387.0f;
+constexpr float kRingInner = 20.0f;
+constexpr float kRingOuter = 80.0f;
+constexpr uint64_t kMinimumPushUs = 150000;
+
+bool IsRunning() {
+    return GuestRegion::ForeignGameAddress("RKDEEB", 1u) != 0;
+}
+
+// The game's 4:3 picture fills the window's height and is centered, with black bars at the sides.
+// Window coordinates to that picture's 640x480; false when the mouse is on a bar.
+bool ToGamePicture(float x, float y, int width, int height, float& gameX, float& gameY) {
+    const float pictureWidth = std::min(static_cast<float>(width), height * kGameWidth / kGameHeight);
+    const float pictureHeight = pictureWidth * kGameHeight / kGameWidth;
+    const float left = (width - pictureWidth) / 2.0f;
+    const float top = (height - pictureHeight) / 2.0f;
+    gameX = (x - left) / pictureWidth * kGameWidth;
+    gameY = (y - top) / pictureHeight * kGameHeight;
+    return gameX >= 0.0f && gameY >= 0.0f && gameX < kGameWidth && gameY < kGameHeight;
+}
+
+// The stick direction for a click on the ring, snapped to the nearest of eight; false off the ring.
+bool RingDirection(float gameX, float gameY, float& stickX, float& stickY) {
+    const float dx = gameX - kRingCenterX;
+    const float dy = kRingCenterY - gameY; // the stick's Y points up, the picture's down
+    const float distance = std::sqrt(dx * dx + dy * dy);
+    if (distance < kRingInner || distance > kRingOuter) {
+        return false;
+    }
+    constexpr float kEighth = 3.14159265f / 4.0f;
+    const float angle = std::round(std::atan2(dy, dx) / kEighth) * kEighth;
+    stickX = std::cos(angle);
+    stickY = std::sin(angle);
+    return true;
+}
+
+struct ToolClick {
+    bool active = false;       // the current left click started on the ring
+    bool wasPressed = false;   // the left button on the last sample
+    float stickX = 0.0f;
+    float stickY = 0.0f;
+    uint64_t startedUs = 0;
+};
+
+// Turns a left click on the ring into a stick push. Returns true while that push lasts, so the
+// caller leaves A unpressed.
+bool PushToolStick(bool pressed, bool onPicture, float gameX, float gameY, EmulatedInput& input) {
+    static ToolClick click;
+    const uint64_t now = NowUs();
+    if (pressed && !click.wasPressed) {
+        click.active = onPicture && RingDirection(gameX, gameY, click.stickX, click.stickY);
+        click.startedUs = now;
+    }
+    click.wasPressed = pressed;
+    if (click.active && !pressed && now - click.startedUs >= kMinimumPushUs) {
+        click.active = false;
+    }
+    if (!click.active) {
+        return false;
+    }
+    input.stickX = click.stickX;
+    input.stickY = click.stickY;
+    return true;
+}
+
+// To line the game's pointer up with the mouse: twice a second, the pointer this remote is given and
+// where the game's KPAD put it. KPADRead fills ten 0x88-byte samples per remote from 0x80281578,
+// newest first, with the pointer's position (-1..1) at +0x20 and +0x24.
+void LogPointerCalibration(const EmulatedInput& input) {
+    constexpr uint32_t kKpadStatus = 0x80281578u;
+    constexpr uint64_t kEveryUs = 500000;
+    static uint64_t s_lastUs = 0;
+    const uint64_t now = NowUs();
+    if (!input.pointerValid || now - s_lastUs < kEveryUs) {
+        return;
+    }
+    s_lastUs = now;
+    auto readFloat = [](uint32_t address) {
+        const uint32_t bits = Memory::Read32(address);
+        float value;
+        std::memcpy(&value, &bits, sizeof(value));
+        return value;
+    };
+    RT_LOG(RT_TAG_MOD) << "[pointer] given " << input.pointerX << " " << input.pointerY << " game "
+                       << readFloat(kKpadStatus + 0x20u) << " " << readFloat(kKpadStatus + 0x24u) << std::endl;
+}
+
+// True once the left button has been held for kPinchAfterUs without a break.
+bool HeldLongEnoughToPinch(bool held) {
+    constexpr uint64_t kPinchAfterUs = 120000;
+    static uint64_t s_heldSinceUs = 0;
+    if (!held) {
+        s_heldSinceUs = 0;
+        return false;
+    }
+    const uint64_t now = NowUs();
+    if (s_heldSinceUs == 0) {
+        s_heldSinceUs = now;
+    }
+    return now - s_heldSinceUs >= kPinchAfterUs;
+}
+
