+            if ((mouse & SDL_BUTTON_X2MASK) != 0) input.c = true;
+            if ((mouse & SDL_BUTTON_X1MASK) != 0) input.buttons |= RemoteButton::kPlus;
+        }
     }
     return input;
 }
