+// The GPU's copy of a 4:3 perspective camera, made as wide as the frame (see WidensOnlyOnTheGpu). The
+// height of the view stays the same and the sides show more, so whatever sat at a spot of the 4:3
+// picture still sits there in the middle of the wide one. The game keeps its own 4:3 matrix.
+static void WidenOnTheGpu(float m[16], GXProjectionType pt) {
+    if (pt != GX_PERSPECTIVE || !WidensOnlyOnTheGpu() || m[0] == 0.0f) {
+        return;
+    }
+    const float scale = WidePictureAspectScale(m[5] / m[0]);
+    m[0] /= scale;
+    m[2] /= scale;
+}
