diff --git a/runtime/src/hle/game_mods/trauma_center_chapter_select.cpp b/runtime/src/hle/game_mods/trauma_center_chapter_select.cpp
new file mode 100644
--- /dev/null
+++ b/runtime/src/hle/game_mods/trauma_center_chapter_select.cpp
@@ -0,0 +1,179 @@
+// Trauma Center: Second Opinion (RKDEEB): chapter select, with saving turned off while it is on.
+// F10 > Mods > Chapter select picks where the story starts; it lasts until the game is closed and is
+// never written to Config.toml, so the next start is always the normal game.
+//
+// How the game knows how far the player got. The progress (the save data while playing) is at
+// *(0x803A7488); a bit field at its +0x40 has one bit per episode, set once the episode is reached
+// (0x80015D1C sets a bit, 0x80015CFC tests one). The episodes are numbered from the table at
+// *(0x803A6B88): chapter 0 has two numbers (0 and 1), then chapter 1's episodes follow from 2, and so
+// on (0x80096B38); an episode's bit is 0x50 plus its number. The Episode Select starts from the
+// latest reached episode of chapters 6 down to 1 (0x8005F474) and offers the ones reached before it.
+//
+// Here the test answers "reached" for every episode before the chosen chapter and for its first
+// episode, for the progress being played only, without changing it. Choosing "every episode" answers
+// "reached" for all of chapters 1 to 6 and Z (the table's chapter 7). The X operations (chapters 8
+// and 9) stay as the game has them.
+//
+// Saving: every write to the Wii's memory starts with 0x8001CEBC (the "NandProc" task: file name,
+// data, size and a work area). While a chapter is chosen it starts nothing and leaves the error
+// -1 in the work area, so the game says the save failed and nothing reaches save.dat.
+//
+// Selección de capítulo: el juego cree que ya llegaste hasta el capítulo elegido, sin cambiar tus
+// datos, y no deja guardar mientras está activa.
+
+#include "game_mods.h"
+#include "guest_abi/cpu_context.h"
+#include "guest_abi/dispatch.h"
+#include "guest_abi/guest_region.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "runtime_log.h"
+
+#include <imgui.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <initializer_list>
+
+namespace TraumaCenterChapterSelect {
+namespace {
+
+// What the menu offers: 0 is the normal game, 1 to 6 start at that chapter, 7 opens every episode.
+constexpr int kOff = 0;
+constexpr int kLastChapter = 6;
+constexpr int kEveryEpisode = 7;
+std::atomic_int g_choice{kOff};
+
+constexpr uint32_t kProgress = 0x803A7488u; // -0x7238(r13): the progress being played
+constexpr uint32_t kFirstEpisodeBit = 0x50u;
+
+// How many episodes each chapter has (the game's table at *(0x803A6B88), chapters 0 to 7; chapter 7
+// is Z).
+constexpr std::array<uint32_t, 8> kEpisodesInChapter = {13, 8, 11, 10, 11, 9, 8, 5};
+
+// The episode's number, as 0x80096B38 counts it (chapters from 1).
+uint32_t EpisodeNumber(int chapter, uint32_t episode) {
+    uint32_t number = 2;
+    for (int earlier = 1; earlier < chapter; ++earlier) {
+        number += kEpisodesInChapter[earlier];
+    }
+    return number + episode - 1;
+}
+
+// True when the chosen chapter makes this episode bit "reached".
+bool ForcedReached(uint32_t bit) {
+    const int choice = g_choice.load(std::memory_order_relaxed);
+    if (choice == kOff || bit < kFirstEpisodeBit) {
+        return false;
+    }
+    const uint32_t number = bit - kFirstEpisodeBit;
+    const uint32_t chapterOne = EpisodeNumber(1, 1);
+    if (choice == kEveryEpisode) {
+        return number >= chapterOne && number <= EpisodeNumber(7, kEpisodesInChapter[7]);
+    }
+    if (number >= chapterOne && number <= EpisodeNumber(choice, 1)) {
+        return true;
+    }
+    // Z's episodes come before chapter 6 in the story.
+    return choice == kLastChapter && number >= EpisodeNumber(7, 1) &&
+           number <= EpisodeNumber(7, kEpisodesInChapter[7]);
+}
+
+constexpr std::array<const char*, 8> kChoices = {
+    "Off (normal game, saving on)", "Chapter 1", "Chapter 2", "Chapter 3", "Chapter 4", "Chapter 5",
+    "Chapter 6", "Every episode"};
+
+void DrawSettings() {
+    int choice = g_choice.load(std::memory_order_relaxed);
+    if (ImGui::BeginCombo("Start at", kChoices[static_cast<size_t>(choice)])) {
+        for (size_t i = 0; i < kChoices.size(); ++i) {
+            const bool isSelected = static_cast<int>(i) == choice;
+            if (ImGui::Selectable(kChoices[i], isSelected) && !isSelected) {
+                g_choice.store(static_cast<int>(i), std::memory_order_relaxed);
+                RT_LOG(RT_TAG_MOD) << "Chapter select: " << kChoices[i] << std::endl;
+            }
+            if (isSelected) {
+                ImGui::SetItemDefaultFocus();
+            }
+        }
+        ImGui::EndCombo();
+    }
+    ImGui::TextDisabled("Pick it on the title screen, then start a New Game or load a file:");
+    ImGui::TextDisabled("the Episode Select offers every episode up to the chosen chapter.");
+    if (choice != kOff) {
+        ImGui::TextColored(ImVec4(1.0f, 0.65f, 0.3f, 1.0f), "Saving is off until this is back to Off.");
+    }
+    ImGui::TextDisabled("Not kept: the game always starts normal.");
+}
+
+bool TraumaCenterRunning() { return ::GuestRegion::ForeignGameAddress("RKDEEB", 1u) != 0; }
+
+const bool kSettingsPanel =
+    (GameMods::RegisterSettingsPanel({"Chapter select", TraumaCenterRunning, DrawSettings}), true);
+
+uint32_t Call(uint32_t function, CpuContext* ctx, std::initializer_list<uint32_t> arguments) {
+    uint32_t reg = 3;
+    for (const uint32_t argument : arguments) {
+        ctx->gpr[reg++] = argument;
+    }
+    InvokeIndirectCpu(function, ctx);
+    return ctx->gpr[3];
+}
+
+} // namespace
+} // namespace TraumaCenterChapterSelect
+
+// 0x80015CFC: tests bit r3 of the bit field at r4 + 0x40 (gives back the bit's mask, or 0).
+// Prueba un bit del progreso; con un capítulo elegido, los episodios anteriores cuentan como alcanzados.
+extern "C" void TraumaCenterProgressBit(CpuContext* ctx) {
+    using namespace TraumaCenterChapterSelect;
+    constexpr uint32_t kBitField = 0x40u;
+    const uint32_t bit = ctx->gpr[3];
+    const uint32_t data = ctx->gpr[4];
+    const uint32_t mask = 1u << (bit & 31u);
+    uint32_t answer = Memory::Read32(data + kBitField + (bit >> 5) * 4u) & mask;
+    if (answer == 0 && data == Memory::Read32(kProgress) && ForcedReached(bit)) {
+        answer = mask;
+    }
+    ctx->gpr[3] = answer;
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 80015CFC, TraumaCenterProgressBit);
+
+// 0x8001CEBC: starts the "NandProc" task that writes a file to the Wii's memory (r3 the name, r4 the
+// data, r5 its size, r6 a work area of 0x16C bytes whose +0x124 gets the result). Done here exactly
+// as the game does it, except while a chapter is chosen: then no task starts and the result is -1,
+// which the game reports as a failed save.
+// Guarda un archivo en la memoria del Wii; con un capítulo elegido no guarda nada y avisa que falló.
+extern "C" void TraumaCenterStartNandWrite(CpuContext* ctx) {
+    using namespace TraumaCenterChapterSelect;
+    constexpr uint32_t kMemset = 0x80004104u;
+    constexpr uint32_t kStrcpy = 0x8012A200u;
+    constexpr uint32_t kCreateTask = 0x8000D6E4u;
+    constexpr uint32_t kNandProcName = 0x80228A48u; // "NandProc"
+    constexpr uint32_t kNandProcStep = 0x8001CB54u;
+    constexpr uint32_t kNandProcEnd = 0x8001CEB8u;
+    constexpr uint32_t kNandCommandBlock = 0x80287870u;
+    constexpr uint32_t kWorkSize = 0x16Cu;
+    constexpr uint32_t kWriteFile = 3u;
+    constexpr uint32_t kResult = 0x124u;
+    const uint32_t returnAddress = ctx->lr;
+    const uint32_t name = ctx->gpr[3];
+    const uint32_t data = ctx->gpr[4];
+    const uint32_t size = ctx->gpr[5];
+    const uint32_t work = ctx->gpr[6];
+    Call(kMemset, ctx, {work, 0, kWorkSize});
+    Memory::Write32(work, kWriteFile);
+    Call(kStrcpy, ctx, {work + 0xCu, name});
+    Memory::Write32(work + 0x10Cu, data);
+    Memory::Write32(work + 0x110u, size);
+    if (g_choice.load(std::memory_order_relaxed) != kOff) {
+        Memory::Write32(work + kResult, 0xFFFFFFFFu);
+        RT_LOG(RT_TAG_MOD) << "Chapter select is on: the game was not saved" << std::endl;
+    } else {
+        Memory::Write32(kNandCommandBlock, work); // NANDSetUserData
+        Call(kCreateTask, ctx, {kNandProcName, 1, 0, 0, kNandProcStep, kNandProcEnd, work});
+    }
+    ctx->lr = returnAddress;
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 8001CEBC, TraumaCenterStartNandWrite);
