+// Trauma Center: Second Opinion (RKDEEB): two places where the game waits by spinning, made to wait
+// for the next retrace instead.
+//
+// On the Wii, the OS takes the processor away from a thread whenever a more important one is ready
+// (on every retrace, when a disc read finishes...), so a thread can wait by checking a flag over and
+// over. WiiCompiled's threads only switch when a thread waits through the OS (OSSleepThread,
+// VIWaitForRetrace...), so a thread that spins keeps the processor, nothing else runs, and the flag
+// it waits for is never set: the game freezes. Each native below does exactly what the game's code
+// does, with a VIWaitForRetrace where the game spun.
+//
+// En el Wii, el sistema le quita el procesador a un hilo cuando otro más importante está listo, así
+// que un hilo puede esperar revisando una bandera una y otra vez. En WiiCompiled los hilos solo
+// cambian cuando uno espera a través del sistema, así que ese hilo se queda con el procesador y el
+// juego se congela. Cada función de abajo hace lo mismo que el código del juego, pero espera el
+// siguiente retrace donde el juego daba vueltas.
+
+#include "guest_abi/cpu_context.h"
+#include "guest_abi/dispatch.h"
+#include "hle_stubs.h"
+#include "memory.h"
+#include "runtime_log.h"
+#include "hle/gx/gx_frame_trace.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <initializer_list>
+#include <string>
+
+namespace TraumaCenterWaits {
+namespace {
+
+constexpr uint32_t kVIWaitForRetrace = 0x80144418u;
+
+// Calls a function of the game with up to four arguments and gives back r3.
+uint32_t Call(uint32_t function, CpuContext* ctx, std::initializer_list<uint32_t> arguments) {
+    uint32_t reg = 3;
+    for (const uint32_t argument : arguments) {
+        ctx->gpr[reg++] = argument;
+    }
+    InvokeIndirectCpu(function, ctx);
+    return ctx->gpr[3];
+}
+
+void WaitForRetrace(CpuContext* ctx) {
+    InvokeIndirectCpu(kVIWaitForRetrace, ctx);
+}
+
+// The file name a load asks for, for the log (at most 63 characters).
+std::string GuestText(uint32_t address) {
+    std::string text;
+    for (uint32_t i = 0; address != 0 && i < 63; ++i) {
+        const char c = static_cast<char>(Memory::Read8(address + i));
+        if (c == 0) {
+            break;
+        }
+        text.push_back(c);
+    }
+    return text;
+}
+
+// ---------------------------------------------------------------- the sound streaming thread
+//
+// The thread at 0x8006F8B0 (started by cadThread.cpp's helper 0x80016A08 right after AIInit and
+// AXInit) checks three sound slots forever and never blocks. One pass:
+//   0x803A76E4  a sound whose record (+0x38) is marked done (+0x4C == 1): its channel's state byte
+//               (0x803A76A0 + the channel at +9) becomes 2 and the mark is cleared;
+//   0x803A76E0  the same, once 0x801FE570 (the channel's two records, second argument 1) returns 1,
+//               and then +0xA becomes 2 too;
+//   0x803A76E8  the same as the one before, with the second argument 0.
+
+constexpr uint32_t kDoneSlot = 0x803A76E4u;
+constexpr uint32_t kFirstStreamSlot = 0x803A76E0u;
+constexpr uint32_t kSecondStreamSlot = 0x803A76E8u;
+constexpr uint32_t kChannelStates = 0x803A76A0u;
+constexpr uint32_t kStreamRecords = 0x802B1490u;  // 0xD8 bytes per channel
+constexpr uint32_t kStreamRequests = 0x802B1728u; // 0x2C bytes per channel
+constexpr uint32_t kStreamStep = 0x801FE570u;
+constexpr uint8_t kStateFinished = 2;
+
+// The record of the sound a slot points at, or 0 when the slot is empty or the sound is not done.
+uint32_t DoneRecord(uint32_t slot) {
+    const uint32_t sound = Memory::Read32(slot);
+    if (sound == 0) {
+        return 0;
+    }
+    const uint32_t record = Memory::Read32(sound + 0x38u);
+    return Memory::Read8(record + 0x4Cu) == 1 ? record : 0;
+}
+
+void MarkFinished(uint32_t record) {
+    Memory::Write8(kChannelStates + Memory::Read8(record + 0x09u), kStateFinished);
+    Memory::Write8(record + 0x4Cu, 0);
+}
+
+void CheckStream(uint32_t slot, uint32_t secondArgument, CpuContext* ctx) {
+    const uint32_t record = DoneRecord(slot);
+    if (record == 0) {
+        return;
+    }
+    const uint32_t channel = Memory::Read8(record + 0x09u);
+    const uint32_t finished = Call(kStreamStep, ctx,
+                                   {kStreamRecords + channel * 0xD8u, secondArgument,
+                                    kStreamRequests + channel * 0x2Cu, 0});
+    if (finished != 1) {
+        return;
+    }
+    Memory::Write8(record + 0x0Au, kStateFinished);
+    MarkFinished(record);
+}
+
+// ---------------------------------------------------------------- loading a file and waiting for it
+//
+// 0x8000BCDC (cadFile.cpp, line 0x1BB) loads a file and returns its data. When the file is already
+// in memory (0x8011A7E8 finds it) it answers at once; otherwise 0x8000BE60 starts a read and returns
+// its request, and the function spins until bit 0 of the request's first word says the read is done.
+//   request +0x40  the size, written to *r4 when r4 is not 0
+//   request +0x4C  the data, returned
+// 0x8000C354 allocates and 0x8000C444 frees (both cadFile.cpp's own); 0x80094A58 records the source
+// line for the allocator.
+
+constexpr uint32_t kCadFileName = 0x802284D8u; // "cadFile.cpp"
+constexpr uint32_t kNoteSourceLine = 0x80094A58u;
+constexpr uint32_t kAllocate = 0x8000C354u;
+constexpr uint32_t kFree = 0x8000C444u;
+constexpr uint32_t kFindLoaded = 0x8011A7E8u;
+constexpr uint32_t kStartLoad = 0x8000BE60u;
+
+} // namespace
+} // namespace TraumaCenterWaits
+
+// 0x8006F8B0: the sound streaming thread's entry. It never returns, like the original.
+namespace TraumaCenterWaits {
+namespace {
+// While the screen stays black: the HOME button library's loader (its state at +0x94 goes 0, 1, 2 and
+// the main loop runs the game only at 2) and the five files it waits for (each done at state 4), and
+// the main loop's flags. Logged each time one of them changes, so the log shows where start-up stops.
+constexpr uint32_t kHomeButtonLoader = 0x803A7688u; // -0x7038(r13)
+constexpr uint32_t kMainLoopFlags = 0x803A73FCu;    // -0x72C4(r13)
+
+uint32_t ReadIfGuest(uint32_t address) {
+    return (address >= 0x80000000u && address < 0x81800000u) ? Memory::Read32(address) : 0xFFFFFFFFu;
+}
+
+void LogStartUpState() {
+    static uint32_t s_last[8] = {0xDEADBEEFu};
+    uint32_t now[8] = {};
+    const uint32_t loader = Memory::Read32(kHomeButtonLoader);
+    now[0] = loader;
+    now[1] = loader != 0 ? ReadIfGuest(loader + 0x94u) : 0;
+    for (uint32_t i = 0; i < 5; ++i) {
+        const uint32_t file = loader != 0 ? ReadIfGuest(loader + 0x9Cu + i * 4u) : 0;
+        now[2 + i] = (file != 0 && file != 0xFFFFFFFFu) ? ReadIfGuest(file + 0x0Cu) : 0xFFFFFFFFu;
+    }
+    now[7] = Memory::Read32(kMainLoopFlags);
+    bool changed = false;
+    for (int i = 0; i < 8; ++i) {
+        changed |= now[i] != s_last[i];
+        s_last[i] = now[i];
+    }
+    if (changed) {
+        RT_LOG(RT_TAG_MOD) << "[start-up] home loader 0x" << std::hex << now[0] << " state " << now[1]
+                           << " files " << now[2] << " " << now[3] << " " << now[4] << " " << now[5]
+                           << " " << now[6] << " main flags 0x" << now[7] << std::dec << std::endl;
+    }
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+namespace TraumaCenterWaits {
+namespace {
+// The title scene waits for the "slCheck" task (the save check), which waits for the save task. Both
+// are the game's own tasks; 0x8000DD4C finds one by name and its work area is at +0x38. Their steps
+// and results are logged when they change.
+constexpr uint32_t kFindTask = 0x8000DD4Cu;
+constexpr uint32_t kSaveCheckTaskName = 0x803A6850u; // "slCheck"
+constexpr uint32_t kSaveTaskName = 0x80228A48u;
+
+void LogSaveTasks(CpuContext* ctx) {
+    static uint32_t s_last[6] = {0xDEADBEEFu};
+    uint32_t now[6] = {0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu};
+    if (const uint32_t check = Call(kFindTask, ctx, {kSaveCheckTaskName})) {
+        const uint32_t work = Memory::Read32(check + 0x38u);
+        now[0] = Memory::Read32(work);
+        now[1] = Memory::Read32(work + 0x12Cu);
+        now[2] = Memory::Read32(work + 0x130u);
+    }
+    if (const uint32_t save = Call(kFindTask, ctx, {kSaveTaskName})) {
+        const uint32_t work = Memory::Read32(save + 0x38u);
+        now[3] = Memory::Read32(work + 0x04u);
+        now[4] = Memory::Read32(work + 0x08u);
+        now[5] = Memory::Read32(work + 0x124u);
+    }
+    bool changed = false;
+    for (int i = 0; i < 6; ++i) {
+        changed |= now[i] != s_last[i];
+        s_last[i] = now[i];
+    }
+    if (changed) {
+        RT_LOG(RT_TAG_MOD) << "[start-up] slCheck step " << static_cast<int32_t>(now[0]) << " (0x12C "
+                           << static_cast<int32_t>(now[1]) << ", 0x130 " << static_cast<int32_t>(now[2])
+                           << "), save task step " << static_cast<int32_t>(now[3]) << " (8 "
+                           << static_cast<int32_t>(now[4]) << ", result " << static_cast<int32_t>(now[5])
+                           << ")" << std::endl;
+    }
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+namespace TraumaCenterWaits {
+namespace {
+// The game draws its 3D scenes from a table at 0x80282E98: eight bytes per scene, flags then the
+// NW4R g3d ScnRoot. ScnRoot::DrawOpa draws what the gather object at +0xB8 collected. No model has
+// been drawn yet, so log each scene's flags, its root and the gather object's first words when they
+// change, to see whether the gathered lists are empty.
+constexpr uint32_t kSceneTable = 0x80282E98u;
+constexpr int kScenesLogged = 4;
+constexpr int kGatherWords = 8;
+constexpr int kRootWords = 10; // the root's words from +0x98: its ScnGroup child list sits before +0xB8
+
+void LogScenes() {
+    static uint32_t s_last[kScenesLogged][2 + kGatherWords + kRootWords] = {};
+    for (int scene = 0; scene < kScenesLogged; ++scene) {
+        uint32_t now[2 + kGatherWords + kRootWords] = {};
+        now[0] = Memory::Read32(kSceneTable + scene * 8u);
+        now[1] = Memory::Read32(kSceneTable + scene * 8u + 4u);
+        const uint32_t gather = now[1] != 0 ? ReadIfGuest(now[1] + 0xB8u) : 0;
+        for (int i = 0; i < kGatherWords; ++i) {
+            now[2 + i] = (gather != 0 && gather != 0xFFFFFFFFu) ? ReadIfGuest(gather + i * 4u) : 0;
+        }
+        for (int i = 0; i < kRootWords; ++i) {
+            now[2 + kGatherWords + i] = now[1] != 0 ? ReadIfGuest(now[1] + 0x98u + i * 4u) : 0;
+        }
+        if (std::memcmp(now, s_last[scene], sizeof(now)) == 0) {
+            continue;
+        }
+        std::memcpy(s_last[scene], now, sizeof(now));
+        auto& log = RT_LOG(RT_TAG_MOD);
+        log << "[start-up] scene " << scene << " flags 0x" << std::hex << now[0] << " root 0x" << now[1]
+            << " gather";
+        for (int i = 0; i < kGatherWords; ++i) {
+            log << " " << now[2 + i];
+        }
+        log << " root+0x98";
+        for (int i = 0; i < kRootWords; ++i) {
+            log << " " << now[2 + kGatherWords + i];
+        }
+        log << std::dec << std::endl;
+    }
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+namespace TraumaCenterWaits {
+namespace {
+// The game's own tasks sit in three lists (-0x7290, -0x7278 and -0x7284 off r13). Each task keeps its
+// name at +0, its next task at +0x3C and its two functions at +0x30 and +0x34. The scenes stay empty
+// on the title screen, so log the running tasks whenever the set changes, to see which are missing.
+constexpr uint32_t kTaskLists[3] = {0x803A7430u, 0x803A7448u, 0x803A743Cu};
+
+void LogTasks() {
+    static std::string s_last;
+    std::string now;
+    for (int list = 0; list < 3; ++list) {
+        now += list == 0 ? "" : " |";
+        uint32_t task = Memory::Read32(kTaskLists[list]);
+        for (int count = 0; task >= 0x80000000u && task < 0x81800000u && count < 64; ++count) {
+            // Also the first four words of its work area (+0x38), where a task keeps its own step.
+            const uint32_t work = Memory::Read32(task + 0x38u);
+            uint32_t step[4] = {};
+            for (uint32_t i = 0; i < 4; ++i) {
+                step[i] = (work >= 0x80000000u && work < 0x81800000u) ? Memory::Read32(work + i * 4u) : 0;
+            }
+            char line[160];
+            std::snprintf(line, sizeof(line), " %s(%08x,%08x work %08x:%x,%x,%x,%x)", GuestText(task).c_str(),
+                          Memory::Read32(task + 0x30u), Memory::Read32(task + 0x34u), work, step[0], step[1],
+                          step[2], step[3]);
+            now += line;
+            task = Memory::Read32(task + 0x3Cu);
+        }
+    }
+    if (now != s_last) {
+        s_last = now;
+        RT_LOG(RT_TAG_MOD) << "[start-up] tasks:" << now << std::endl;
+    }
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+namespace TraumaCenterWaits {
+namespace {
+// The title screen's 2D pieces are drawn every frame but come out with alpha 0. Once a second, log
+// the values an animation would move with (the frame time the main loop computes at -0x7268 and
+// -0x72C8, the bus clock it divides by) and the first words of the TTL DRAW PROC work area, where the
+// title keeps its own step and, likely, its fade. Also take two frame traces by itself (as F9 does),
+// 5 and 20 seconds into the title screen, so no key has to be pressed.
+constexpr uint32_t kFrameTime = 0x803A7458u;      // -0x7268(r13), a float
+constexpr uint32_t kFrameTimeBase = 0x803A73F8u;  // -0x72C8(r13), a float
+constexpr uint32_t kBusClock = 0x800000F8u;
+constexpr int kTitleWords = 24;
+
+uint32_t FindTaskByName(const char* name) {
+    for (uint32_t list : kTaskLists) {
+        uint32_t task = Memory::Read32(list);
+        for (int count = 0; task >= 0x80000000u && task < 0x81800000u && count < 64; ++count) {
+            if (GuestText(task) == name) {
+                return task;
+            }
+            task = Memory::Read32(task + 0x3Cu);
+        }
+    }
+    return 0;
+}
+
+void LogTitleAnimation() {
+    static uint32_t s_retraces = 0;
+    static uint32_t s_titleRetraces = 0;
+    ++s_retraces;
+    const uint32_t titleDraw = FindTaskByName("TTL DRAW PROC");
+    if (titleDraw == 0) {
+        return;
+    }
+    ++s_titleRetraces;
+    if (s_titleRetraces == 300 || s_titleRetraces == 1200) {
+        RT_LOG(RT_TAG_MOD) << "[start-up] taking a frame trace on the title screen" << std::endl;
+        GxFrameTrace::Request(3);
+    }
+    if (s_retraces % 60 != 0) {
+        return;
+    }
+    const uint32_t work = Memory::Read32(titleDraw + 0x38u);
+    float frameTime;
+    float frameTimeBase;
+    const uint32_t frameTimeBits = Memory::Read32(kFrameTime);
+    const uint32_t frameTimeBaseBits = Memory::Read32(kFrameTimeBase);
+    std::memcpy(&frameTime, &frameTimeBits, sizeof(frameTime));
+    std::memcpy(&frameTimeBase, &frameTimeBaseBits, sizeof(frameTimeBase));
+    auto& log = RT_LOG(RT_TAG_MOD);
+    log << "[start-up] title: frame time " << frameTime << " base " << frameTimeBase << " bus clock "
+        << Memory::Read32(kBusClock) << " draw work 0x" << std::hex << work << ":";
+    for (int i = 0; i < kTitleWords; ++i) {
+        log << " " << ((work >= 0x80000000u && work < 0x81800000u) ? Memory::Read32(work + i * 4u) : 0u);
+    }
+    log << std::dec << std::endl;
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+extern "C" void TraumaCenterSoundThreadLoop(CpuContext* ctx) {
+    using namespace TraumaCenterWaits;
+    for (;;) {
+        LogStartUpState();
+        LogSaveTasks(ctx);
+        LogScenes();
+        LogTasks();
+        LogTitleAnimation();
+        if (const uint32_t record = DoneRecord(kDoneSlot)) {
+            MarkFinished(record);
+        }
+        CheckStream(kFirstStreamSlot, 1, ctx);
+        CheckStream(kSecondStreamSlot, 0, ctx);
+        WaitForRetrace(ctx);
+    }
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 8006F8B0, TraumaCenterSoundThreadLoop);
+
+// 0x8000BCDC: load a file (r3 its name, r5 passed along) and wait for it; the size goes to *r4.
+extern "C" void TraumaCenterLoadFile(CpuContext* ctx) {
+    using namespace TraumaCenterWaits;
+    const uint32_t name = ctx->gpr[3];
+    const uint32_t sizeOut = ctx->gpr[4];
+    const uint32_t extra = ctx->gpr[5];
+
+    Call(kNoteSourceLine, ctx, {kCadFileName, 0x1BBu});
+    const uint32_t block = Call(kAllocate, ctx, {0x50u});
+    const uint32_t found = Call(kFindLoaded, ctx, {name, block + 0x40u, extra});
+    Memory::Write32(block + 0x4Cu, found);
+
+    uint32_t request = block;
+    if (found != 0) {
+        Memory::Write32(sizeOut, Memory::Read32(block + 0x40u)); // the game does not check r4 here
+    } else {
+        // Like the game, the block allocated above is not freed on this path.
+        request = Call(kStartLoad, ctx, {name, extra});
+        // A load that never ends leaves the screen black with nothing in the log, so say which file
+        // it is: once when it starts and again if it is still not done after ten seconds.
+        RT_LOG(RT_TAG_MOD) << "[load] " << GuestText(name) << std::endl;
+        uint32_t retraces = 0;
+        while ((Memory::Read32(request) & 1u) == 0) {
+            WaitForRetrace(ctx);
+            if (++retraces == 600) {
+                RT_LOG(RT_TAG_MOD) << "[load] still waiting for " << GuestText(name) << " (request 0x"
+                                   << std::hex << request << std::dec << ")" << std::endl;
+            }
+        }
+        if (sizeOut != 0) {
+            Memory::Write32(sizeOut, Memory::Read32(request + 0x40u));
+        }
+    }
+    const uint32_t data = Memory::Read32(request + 0x4Cu);
+    Call(kFree, ctx, {request});
+    ctx->gpr[3] = data;
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 8000BCDC, TraumaCenterLoadFile);
+
+// KPADInit waits for the Wii Remote's Bluetooth with `while (WPADGetStatus() != 3) {}`. On the Wii the
+// Bluetooth module answered from its own interrupts during that loop; here the game only moves on at
+// an OS wait, so the loop would spin forever. This is WPADGetStatus (a jump to WUDGetStatus): it reads
+// the same status byte, and when KPADInit is the one asking and the module is not ready yet, it waits
+// one retrace first so the Bluetooth can answer. Every other caller gets the status straight away.
+//
+// KPADInit espera el Bluetooth del Wii Remote dando vueltas sin pausa. Aquí, solo cuando la pregunta
+// viene de KPADInit y todavía no está listo, se espera un retrazado para que el Bluetooth avance.
+namespace TraumaCenterWaits {
+namespace {
+constexpr uint32_t kBluetoothStatus = 0x8031BE28u; // the byte WUDGetStatus reads
+constexpr uint32_t kBluetoothReady = 3;
+constexpr uint32_t kKPADInitWaitLoop = 0x80177328u; // where KPADInit's loop comes back to
+
+int32_t BluetoothStatus() {
+    return static_cast<int8_t>(Memory::Read8(kBluetoothStatus));
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+extern "C" void TraumaCenterWPADGetStatus(CpuContext* ctx) {
+    using namespace TraumaCenterWaits;
+    const uint32_t returnAddress = ctx->lr;
+    int32_t status = BluetoothStatus();
+    if (status != static_cast<int32_t>(kBluetoothReady) && returnAddress == kKPADInitWaitLoop) {
+        WaitForRetrace(ctx);
+        status = BluetoothStatus();
+    }
+    ctx->lr = returnAddress;
+    ctx->gpr[3] = static_cast<uint32_t>(status);
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 8016A828, TraumaCenterWPADGetStatus);
+
+// The main loop stops running the game while its flags have bit 0x2 set. 0x8000A574 sets it (and the
+// counter at -0x7F80(r13) to -1); 0x8000A5D4 sets that counter to 5, and five frames later the main
+// loop clears the bit again. Both are called from many places, so for now these two do exactly what
+// the game's code does and also log who called them, to find the pause that is never undone.
+// El ciclo principal no corre el juego mientras la bandera 0x2 está puesta; aquí se anota quién la pone
+// y quién la quita, para encontrar la pausa que nunca se deshace.
+namespace TraumaCenterWaits {
+namespace {
+constexpr uint32_t kPauseCounter = 0x803A6740u;     // -0x7F80(r13)
+constexpr uint32_t kFadePending = 0x803A7404u;      // -0x72BC(r13), a byte
+constexpr uint32_t kFadeFirstValue = 0x803A7408u;   // -0x72B8(r13), a float
+constexpr uint32_t kFadeSecondValue = 0x803A740Cu;  // -0x72B4(r13), a float
+constexpr uint32_t kStopFade = 0x8000E9DCu;
+constexpr uint32_t kSetFade = 0x8000E9B4u;
+constexpr int kCallsLogged = 40;
+
+float ReadFloat(uint32_t address) {
+    const uint32_t bits = Memory::Read32(address);
+    float value;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+} // namespace
+} // namespace TraumaCenterWaits
+
+extern "C" void TraumaCenterPauseGame(CpuContext* ctx) {
+    using namespace TraumaCenterWaits;
+    const uint32_t returnAddress = ctx->lr;
+    static int s_logged = 0;
+    if (s_logged < kCallsLogged && returnAddress != 0x8003E5ACu) {
+        ++s_logged;
+        RT_LOG(RT_TAG_MOD) << "[start-up] pause from 0x" << std::hex << returnAddress - 4 << std::dec << std::endl;
+    }
+    // The title scene (0x8003E588) pauses the game every frame and keeps its own step at r31's
+    // address: 0 starts a fade, 1 waits for it, 2 starts the "TTL DRAW FILE SETUP" task that loads
+    // title.pak, 3 waits for that task (its state at -0x6E34(r13), done at 3), 4 runs the menu.
+    if (returnAddress == 0x8003E5ACu) {
+        static uint32_t s_lastStep = 0xFFFFFFFFu;
+        static uint32_t s_lastTask = 0xFFFFFFFFu;
+        const uint32_t step = Memory::Read32(ctx->gpr[31]);
+        const uint32_t task = Memory::Read32(0x803A788Cu); // -0x6E34(r13)
+        const uint32_t taskState = task != 0 ? Memory::Read32(task) : 0xFFFFFFFFu;
+        if (step != s_lastStep || taskState != s_lastTask) {
+            s_lastStep = step;
+            s_lastTask = taskState;
+            RT_LOG(RT_TAG_MOD) << "[start-up] title scene step " << step << ", file setup task 0x" << std::hex
+                               << task << " state " << taskState << std::dec << std::endl;
+        }
+    }
+    if (Memory::Read8(kFadePending) != 0) {
+        Call(kStopFade, ctx, {0});
+        ctx->fpr[1].d = ReadFloat(kFadeFirstValue);
+        ctx->fpr[2].d = ReadFloat(kFadeSecondValue);
+        Call(kSetFade, ctx, {0});
+        Memory::Write8(kFadePending, 0);
+    }
+    Memory::Write32(kPauseCounter, 0xFFFFFFFFu);
+    Memory::Write32(kMainLoopFlags, (Memory::Read32(kMainLoopFlags) & ~1u) | 2u);
+    ctx->lr = returnAddress;
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 8000A574, TraumaCenterPauseGame);
+
+extern "C" void TraumaCenterResumeGame(CpuContext* ctx) {
+    using namespace TraumaCenterWaits;
+    static int s_logged = 0;
+    if (s_logged < kCallsLogged) {
+        ++s_logged;
+        RT_LOG(RT_TAG_MOD) << "[start-up] resume from 0x" << std::hex << ctx->lr - 4 << std::dec << std::endl;
+    }
+    Memory::Write32(kPauseCounter, 5);
+}
+FOREIGN_GAME_WRAPPER(RKDEEB, 8000A5D4, TraumaCenterResumeGame);
