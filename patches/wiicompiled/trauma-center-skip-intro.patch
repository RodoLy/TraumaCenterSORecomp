+#pragma once
+
+// Trauma Center: Second Opinion (RKDEEB): comfort changes that leave the game itself alone, each
+// with a switch in F10 > Mods > Trauma Center and in Config.toml [mods]. See trauma_center_comfort.cpp.
+//
+// Comodidades para Trauma Center que no cambian el juego; cada una se apaga en F10 > Mods.
+
+namespace TraumaCenterComfort {
