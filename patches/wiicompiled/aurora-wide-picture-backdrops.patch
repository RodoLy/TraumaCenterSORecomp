+// Some games draw a still background - a room behind the characters, the pattern behind a menu - as
+// one flat quad inside their 3D camera, cut to exactly the 4:3 view. A camera made wide (see
+// AuroraSetWidePicture) then shows past the edges of that quad. When pictures keep their shape
+// (AuroraSetWidePictureStretchesBackgrounds off), such a quad is enlarged evenly instead, across and
+// down, until it reaches both sides of the frame: nothing is stretched, a little is cut at the top and
+// the bottom. A quad counts when its four corners face the camera and reach the left, right, top and
+// bottom edges of the 4:3 view. Real 3D scenery is drawn with more vertices (display lists) and is
+// left alone.
+static bool perspective_draw_is_backdrop(const u8* vertices, u16 vtxCount, u32 vtxStride, GXVtxFmt fmt) noexcept {
+  const float wide = wide_picture_factor();
+  if (s_widePictureStretchesBackgrounds.load(std::memory_order_relaxed) || wide <= 1.f || vtxCount < 3 ||
+      vtxCount > 6 || vtxStride == 0) {
+    return false;
+  }
+  const auto& proj = g_gxState.proj;
+  float left = std::numeric_limits<float>::infinity();
+  float right = -left;
+  float bottom = left;
+  float top = -left;
+  for (u16 i = 0; i < vtxCount; ++i) {
+    float view[3];
+    if (!read_view_position(vertices + static_cast<size_t>(i) * vtxStride, fmt, view)) {
+      return false;
+    }
+    const float w = proj.m3[0] * view[0] + proj.m3[1] * view[1] + proj.m3[2] * view[2] + proj.m3[3];
+    if (!(w > 0.f)) {
+      return false;
+    }
+    // The projection here is already the wide one, where the 4:3 view ends at 1 / wide.
+    const float x = (proj.m0[0] * view[0] + proj.m0[1] * view[1] + proj.m0[2] * view[2] + proj.m0[3]) / w * wide;
+    const float y = (proj.m1[0] * view[0] + proj.m1[1] * view[1] + proj.m1[2] * view[2] + proj.m1[3]) / w;
+    left = std::min(left, x);
+    right = std::max(right, x);
+    bottom = std::min(bottom, y);
+    top = std::max(top, y);
+  }
+  constexpr float edge = 0.97f;
+  return left <= -edge && right >= edge && bottom <= -edge && top >= edge;
+}
