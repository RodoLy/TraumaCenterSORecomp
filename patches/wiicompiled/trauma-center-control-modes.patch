+// True once the right button has been held for kHealingTouchAfterUs without a break. The Healing
+// Touch starts with Z and B held together; B alone is the right click's quick use.
+bool HeldLongEnoughForHealingTouch(bool held) {
+    constexpr uint64_t kHealingTouchAfterUs = 300000;
+    static uint64_t s_heldSinceUs = 0;
+    if (!held) {
+        s_heldSinceUs = 0;
+        return false;
+    }
+    const uint64_t now = NowUs();
+    if (s_heldSinceUs == 0) {
+        s_heldSinceUs = now;
+    }
+    return now - s_heldSinceUs >= kHealingTouchAfterUs;
+}
+
+// With the keyboard, the number keys 1 to 8 pick the tools around the ring, clockwise from the top
+// one: 1 up, 2 up and right, 3 right, 4 down and right, 5 down, 6 down and left, 7 left, 8 up and
+// left. A key pushes the stick toward its tool while held, and at least kMinimumPushUs.
+bool PushToolStickFromKeys(const bool* keys, EmulatedInput& input) {
+    static int s_key = -1;
+    static uint64_t s_startedUs = 0;
+    const uint64_t now = NowUs();
+    int held = -1;
+    for (int i = 0; i < 8; ++i) {
+        if (keys[SDL_SCANCODE_1 + i]) {
+            held = i;
+            break;
+        }
+    }
+    if (held >= 0 && held != s_key) {
+        s_key = held;
+        s_startedUs = now;
+    } else if (held < 0 && s_key >= 0 && now - s_startedUs >= kMinimumPushUs) {
+        s_key = -1;
+    }
+    if (s_key < 0) {
+        return false;
+    }
+    constexpr float kEighth = 3.14159265f / 4.0f;
+    const float angle = 3.14159265f / 2.0f - static_cast<float>(s_key) * kEighth; // from up, clockwise
+    input.stickX = std::cos(angle);
+    input.stickY = std::sin(angle);
+    return true;
+}
