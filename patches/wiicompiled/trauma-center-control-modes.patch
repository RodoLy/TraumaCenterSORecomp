+// The ways a game played with the emulated Wii Remote can be controlled. The mouse is the pointer in
+// all of them; they differ in what holds the rest of the remote and the Nunchuk, and in which
+// instructions the game shows (see the control texts of a game that has them).
+//   mouse             the mouse alone, like a stylus: clicks pick tools and hold to grab
+//   mouse_keys        the mouse and the keyboard: number keys pick tools, keys for the rest
+//   mouse_controller  the mouse and a controller: its stick picks tools, its buttons the rest
+inline constexpr std::array<const char*, 3> kControlModes = {"mouse", "mouse_keys", "mouse_controller"};
+
+inline bool IsSupportedControlMode(std::string_view mode) {
+    return std::find(kControlModes.begin(), kControlModes.end(), mode) != kControlModes.end();
+}
