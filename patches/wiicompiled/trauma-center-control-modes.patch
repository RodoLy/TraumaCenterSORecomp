+// For a game played with the emulated Wii Remote: how it is played (Config.toml [controls] mode).
+// The mouse is the pointer in all three; the choice says what holds the rest of the controls and
+// which instructions the game shows.
+void DrawControlModeSetting() {
+    struct Choice {
+        const char* label;
+        const char* help;
+    };
+    static constexpr std::array<Choice, 3> kChoices = {{
+        {"Mouse only", "Like the DS stylus: click a tool to pick it, hold the click to grab, hold the "
+                       "right button to start the Healing Touch."},
+        {"Mouse and keyboard", "The mouse points and clicks; keys 1 to 8 pick tools (clockwise from the "
+                               "top), Space grabs, Left Shift starts the Healing Touch."},
+        {"Mouse and controller", "The mouse points and clicks; the controller's stick picks tools and its "
+                                 "buttons do the rest, like the Nunchuk."},
+    }};
+    const int current = static_cast<int>(Bluetooth::CurrentControlMode());
+    if (ImGui::BeginCombo("Controls", kChoices[static_cast<size_t>(current)].label)) {
+        for (size_t i = 0; i < kChoices.size(); ++i) {
+            const bool isSelected = static_cast<int>(i) == current;
+            if (ImGui::Selectable(kChoices[i].label, isSelected) && !isSelected) {
+                Bluetooth::SetControlMode(static_cast<Bluetooth::ControlMode>(i));
+                RuntimeConfigFile::SetControlMode(RuntimeConfigFile::kControlModes[i]);
+            }
+            if (isSelected) {
+                ImGui::SetItemDefaultFocus();
+            }
+        }
+        ImGui::EndCombo();
+    }
+    PushMenuTextWrap();
+    ImGui::TextDisabled("%s", kChoices[static_cast<size_t>(current)].help);
+    ImGui::PopTextWrapPos();
+    ImGui::Separator();
+}
+
