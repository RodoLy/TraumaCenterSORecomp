+ControlMode CurrentControlMode() {
+    int mode = g_controlMode.load(std::memory_order_relaxed);
+    if (mode < 0) {
+        const std::string saved = RuntimeConfigFile::ControlMode();
+        mode = 0;
+        for (size_t i = 0; i < RuntimeConfigFile::kControlModes.size(); ++i) {
+            if (saved == RuntimeConfigFile::kControlModes[i]) {
+                mode = static_cast<int>(i);
+            }
+        }
+        g_controlMode.store(mode, std::memory_order_relaxed);
+    }
+    return static_cast<ControlMode>(mode);
+}
+
+void SetControlMode(ControlMode mode) {
+    g_controlMode.store(static_cast<int>(mode), std::memory_order_relaxed);
+}
