 // gx_copy.cpp - Framebuffer Copy Operations
 #include "gx_internal.h"
 
@@ -130,7 +131,25 @@
 // Copy Execution
 // ============================================================================
 
+extern std::atomic<uint32_t> g_gxCallDisplayListCount;
+extern std::atomic<uint32_t> g_gxBeginCount;
+extern std::atomic<uint32_t> g_gxLoadPosMtxImmCount;
+extern std::atomic<uint32_t> g_lcQueueWaitCount;
+
+// Once every 60 frames: how many GXBegin draws and display lists the game sent. A screen that stays
+// black while these are high is drawn but lost on the way; while they are zero the game is not drawing.
+static void LogDrawSummary() {
+    static uint32_t s_frames = 0;
+    if (++s_frames < 60) return;
+    s_frames = 0;
+    RT_LOG(RT_TAG_GX) << "[draws] last 60 frames: " << g_gxBeginCount.exchange(0) << " GXBegin, "
+                      << g_gxCallDisplayListCount.exchange(0) << " display lists, "
+                      << g_gxLoadPosMtxImmCount.exchange(0) << " GXLoadPosMtxImm, "
+                      << g_lcQueueWaitCount.exchange(0) << " LCQueueWait" << std::endl;
+}
+
 extern "C" void GX__CopyDisp_8016fc38(uint32_t da, uint32_t c) {
+    LogDrawSummary();
     GxFrameTrace::Note("CopyDisp to 0x%08X clear=%u", da, c);
     GxFrameTrace::EndFrame();
     EnsureAuroraFrameActive();
